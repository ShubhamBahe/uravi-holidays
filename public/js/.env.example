# Copy to .env (docker compose reads it) or set these in your host's dashboard. Never commit the real .env file.

# Admin login for /admin. Use a long, unique password.
ADMIN_PASSWORD=change-this-to-a-long-password

# Signs the admin login cookie. Any long random string (e.g. run: openssl rand -hex 32)
SESSION_SECRET=

# Only for the docker-compose + Caddy setup: your domain (Caddy gets the HTTPS certificate for it automatically)
DOMAIN=uraviholidays.in

# Optional
# PORT=3000
# DATA_DIR=/data            # where the database and uploaded photos are stored. MUST be a persistent disk/volume
# FORCE_HTTPS=1             # redirect http to https (not needed on Render/Railway, they do it already)
# TRUST_PROXY=1             # number of proxies in front of the app; the default already works for most hosts
